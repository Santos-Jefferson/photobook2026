# Optional: override the photo book API endpoint the app POSTs to.
# If unset, the app uses the default endpoint baked into src/config.js.
VITE_PHOTOBOOK_API_URL=https://genius-narration-api.use.eks.mcap.sip.dev.cloud.synchronoss.net/v1/genius/photobook

# Optional: Bearer token sent as `Authorization: Bearer <key>`. Defaults to "dev-secret".
VITE_PHOTOBOOK_API_KEY=dev-secret

# --- Voice narration ---
# Uses Microsoft Edge neural voices (free, no key) via the /api/narrate server.
# Nothing required. Optionally override the voice per language:
# EDGE_VOICE_EN=en-US-AriaNeural
# EDGE_VOICE_PT=pt-BR-FranciscaNeural
# EDGE_VOICE_ES=es-ES-ElviraNeural

# --- Translation (optional) ---
# Server-side only. When set, captions/narration are localized naturally via
# Claude; when unset, they fall back to the key-less Google endpoint.
# NOTE: this is a server secret — never expose it as a VITE_ (client) var.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com   # override if using a proxy/gateway
# TRANSLATE_MODEL=claude-haiku-4-5               # default; or claude-opus-4-8 for max quality

# Optional: corporate proxy for the local server's outbound calls (if needed).
# HTTPS_PROXY=http://proxy.company.com:8080
