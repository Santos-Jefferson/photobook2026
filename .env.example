# Optional: override the photo book API endpoint the app POSTs to.
# If unset, the app uses the default endpoint baked into src/config.js.
VITE_PHOTOBOOK_API_URL=https://genius-narration-api.use.eks.mcap.sip.dev.cloud.synchronoss.net/v1/genius/photobook

# Optional: Bearer token sent as `Authorization: Bearer <key>`. Defaults to "dev-secret".
VITE_PHOTOBOOK_API_KEY=dev-secret

# --- Voice narration (server-side; used by the /api/narrate function) ---
# SECRET — no VITE_ prefix, so it never reaches the browser. Required to enable
# the natural human voice; without it, narration falls back to the browser voice.
ELEVENLABS_API_KEY=
# Optional ElevenLabs voice IDs (defaults to "Rachel"):
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_VOICE_ID_EN=
# ELEVENLABS_VOICE_ID_PT=
# ELEVENLABS_VOICE_ID_ES=
